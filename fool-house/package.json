{
  "name": "fool-house",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Fool House browser prototype",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:update": "node e2e/run.mjs --update-snapshots",
    "test:e2e:coverage": "node e2e/run.mjs --coverage",
    "test:e2e:types": "tsc -p tsconfig.e2e.json --noEmit",
    "test:regression": "npm test && npm run build && node e2e/check-production.mjs && npm run test:e2e:types && npm run test:e2e:coverage",
    "build:e2e": "vite build --mode e2e --outDir .e2e-dist --sourcemap inline",
    "serve:e2e": "npm run build:e2e && http-server .e2e-dist -a 127.0.0.1 -p 4178 -c-1 --silent",
    "serve:production-test": "vite build && http-server dist -a 127.0.0.1 -p 4179 -c-1 --silent",
    "simulate": "node scripts/simulate.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "http-server dist --port 1234"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "http-server": "^14.1.1",
    "monocart-coverage-reports": "3.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}

{
  "name": "space-balls",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "node --test tests/*.test.mjs test/*.test.mjs tests/struct/*.test.mjs tests/scene/*.test.mjs",
    "test:struct": "node --test tests/struct/*.test.mjs",
    "test:scene": "node --test tests/scene/*.test.mjs",
    "test:browser": "playwright test",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots=all",
    "test:all": "npm test && npm run test:browser && node requirements/verify.mjs",
    "build:browser-test": "tsc --noEmit && vite build --mode browser-test --outDir .browser-test-dist",
    "test:opencv": "node --test test/opencv.test.mjs",
    "test:capture": "node --test test/capture.test.mjs",
    "cv:compile": "node tools/compile-cv-requirements.mjs",
    "cv:check": "node tools/compile-cv-requirements.mjs --check",
    "predev": "npm run cv:compile",
    "prebuild": "npm run cv:compile",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "http-server dist --port 1234"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@techstark/opencv-js": "5.0.0-release.1",
    "happy-dom": "21.0.3",
    "http-server": "^14.1.1",
    "rolldown": "1.2.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
